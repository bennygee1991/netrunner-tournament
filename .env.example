# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string.
# Local (docker compose up -d): postgresql://circuit:circuit@localhost:5432/circuit
# Production: the connection string from your Neon project (Dashboard > Connect).
DATABASE_URL="postgresql://circuit:circuit@localhost:5432/circuit"

# Optional: direct (non-pooled) connection used only for migrations and restores.
# Neon: the connection string with "Connection pooling" switched OFF. Leave empty locally.
DIRECT_URL=""

# First admin account, created once by `pnpm db:seed`. Use a strong password (min 10 chars),
# and change it after first login. You can delete these lines after seeding.
ADMIN_RUNNER_NAME="Organizer"
ADMIN_PASSWORD=""

# Public URL of the site, used to check that forms are submitted from this site. No trailing slash.
# On Vercel this is optional for the *.vercel.app address; set it if you add a custom domain.
APP_URL="http://localhost:3000"

# Time zone used to display event dates (IANA name, e.g. Europe/London, America/New_York).
APP_TIMEZONE="UTC"

# Separate database for automated tests (wiped by the tests). Leave empty to skip DB tests.
TEST_DATABASE_URL="postgresql://circuit:circuit@localhost:5432/circuit_test"

# Optional: path to an existing Chromium for `pnpm e2e` (otherwise run `pnpm exec playwright install chromium`).
PW_CHROMIUM_PATH=""
