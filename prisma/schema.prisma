// Netrunner Circuit data model. See docs/SPEC.md section 6.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum SeasonStatus {
  ACTIVE
  ARCHIVED
}

enum EventStatus {
  SIGNUP
  SWISS
  CUT
  DONE
}

enum CutFormat {
  SINGLE
  SERIES
}

enum MatchFormat {
  SINGLE
  DOUBLE
}

enum Phase {
  SWISS
  CUT
}

/// Result of one game: A won, B won, or Draw (tie).
enum GameResult {
  A
  B
  D
}

model User {
  id                 String    @id @default(cuid())
  /// Shown with the original casing.
  runnerName         String
  /// Lower-cased runner name, used for uniqueness and lookup.
  runnerNameLower    String    @unique
  passwordHash       String
  email              String?
  role               Role      @default(PLAYER)
  mustChangePassword Boolean   @default(false)
  disabledAt         DateTime?
  /// Short public bio shown on the profile page (plain text, max 280 chars).
  bio                String?
  /// Chosen preset avatar key (see src/lib/avatars.ts); null = automatic default.
  avatar             String?
  /// Up to 3 badge or trophy keys shown next to the name in the players directory.
  featuredBadges     String[]  @default([])
  /// Own result reports the organizer approved (for the Reporter badge).
  reportsApproved    Int       @default(0)
  /// Display preferences (JSON object, validated with zod in the app).
  prefs              Json      @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions     Session[]
  signups      Signup[]
  entrants     Entrant[]
  auditLogs    AuditLog[]
  eventRecords EventRecord[]
  trophies     Trophy[]
  guideEdits   GuideRevision[]
  reports      ResultReport[]
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored here.
model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window rate limit buckets (login/register throttling), shared across server instances.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model Season {
  id         String       @id @default(cuid())
  name       String
  startDate  DateTime     @db.Date
  status     SeasonStatus @default(ACTIVE)
  /// Prize text per leaderboard: { month1?: string, month2?: string, season?: string }.
  prizesJson Json         @default("{}")
  createdAt  DateTime     @default(now())
  archivedAt DateTime?

  events    Event[]
  snapshots LeaderboardSnapshot[]
  trophies  Trophy[]

  @@index([status])
}

model Event {
  id          String      @id @default(cuid())
  /// Null for a one-off event (no season, no league points).
  seasonId    String?
  /// 1..4 within the season (0 for one-off events).
  index       Int
  name        String
  date        DateTime    @db.Date
  /// Local start time "HH:MM" in APP_TIMEZONE (optional).
  startTime   String?
  /// Where the event is held (optional, plain text).
  venue       String?
  /// Extra info for players: address details, parking, entry fee… (optional, plain text).
  notes       String?
  /// 1 or 2.
  month       Int
  status      EventStatus @default(SIGNUP)
  matchFormat MatchFormat @default(SINGLE)
  /// Null = use the engine default for the player count.
  swissRounds Int?
  /// 0, 4 or 8.
  cutSize     Int         @default(4)
  /// Season finale: double league points.
  finale      Boolean     @default(false)
  /// How cut matches are played (SERIES: higher seed picks sides, swap, coin-flip game 3).
  cutFormat   CutFormat   @default(SINGLE)
  /// Optimistic lock: bumped on every tournament state change.
  version     Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /// Round clock: current round key, its clock and series-cut decider clocks (see src/lib/clock.ts).
  clockJson Json?

  season   Season?        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entrants Entrant[]
  signups  Signup[]
  rounds   Round[]
  reports  ResultReport[]
  records  EventRecord[]
  trophies Trophy[]

  @@unique([seasonId, index])
  @@index([date])
}

/// A player taking part in an event: either a registered user or a walk-in guest.
model Entrant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  guestName String?
  dropped   Boolean  @default(false)
  createdAt DateTime @default(now())

  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchesA    Match[] @relation("MatchA")
  matchesB    Match[] @relation("MatchB")
  matchesCorp Match[] @relation("MatchCorp")

  @@unique([eventId, userId])
  @@index([userId])
}

model Signup {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Round {
  id        String   @id @default(cuid())
  eventId   String
  phase     Phase
  number    Int
  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([eventId, phase, number])
}

/// One pairing. bEntrantId null = bye. corpEntrantId = Corp in game 1 (sides swap in game 2 for double-sided).
model Match {
  id             String      @id @default(cuid())
  roundId        String
  table          Int
  aEntrantId     String
  bEntrantId     String?
  corpEntrantId  String?
  result1        GameResult?
  result2        GameResult?
  /// Series cut decider (game 3) and its Corp (coin flip).
  result3        GameResult?
  corp3EntrantId String?

  round Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  a     Entrant  @relation("MatchA", fields: [aEntrantId], references: [id], onDelete: Cascade)
  b     Entrant? @relation("MatchB", fields: [bEntrantId], references: [id], onDelete: Cascade)
  corp  Entrant? @relation("MatchCorp", fields: [corpEntrantId], references: [id], onDelete: Cascade)

  @@index([roundId])
}

/// Written at season end: board rows (names, points, prizes) frozen for Past seasons.
model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  seasonId  String
  /// month1 | month2 | season
  boardKey  String
  rowsJson  Json
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, boardKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// Runner name at the time of the action, kept even if the account is later deleted.
  actorName  String
  action     String
  detailJson Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/**
 * Permanent per-player result of a finished event. Written when an event finishes, removed if it is
 * reopened. Survives season resets (the event link is cleared) so profiles and milestones keep history.
 */
model EventRecord {
  id             String   @id @default(cuid())
  eventId        String?
  seasonName     String
  eventName      String
  eventDate      DateTime @db.Date
  userId         String?
  /// Name at the time (guest name for walk-ins).
  playerName     String
  placing        String
  rank           Int
  points         Int
  wins           Int
  draws          Int
  losses         Int
  champion       Boolean
  /// Finished Swiss without losing a game (at least one game played).
  undefeated     Boolean
  /// Stable event identity that survives the event being deleted (the event id when written).
  eventKey       String
  seasonId       String?
  finale         Boolean  @default(false)
  madeCut        Boolean  @default(false)
  cutSeed        Int?
  cutSize        Int?
  cutDraws       Int      @default(0)
  cutLosses      Int      @default(0)
  lostFirstRound Boolean  @default(false)
  corpWins       Int      @default(0)
  runnerWins     Int      @default(0)
  /// Registered opponents (user ids), for the Mentor badge.
  opponentIds    String[] @default([])
  /// One-off event (not part of a season): no league points, separate badges.
  oneOff         Boolean  @default(false)
  /// 1 = written before badges existed (side wins and opponents unknown), 2 = full facts.
  statsVersion   Int      @default(1)
  createdAt      DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
}

/// Season podium and event champion trophies (milestones are derived from EventRecord).
model Trophy {
  id         String   @id @default(cuid())
  /// season-champion | season-second | season-third | event-champion | finale-champion |
  /// month1-champion | month2-champion
  kind       String
  userId     String?
  playerName String
  seasonId   String?
  seasonName String
  eventId    String?
  eventName  String?
  awardedAt  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
}

/// A Guides (wiki) page written by organizers in Markdown. Players see published pages.
model GuidePage {
  id        String   @id @default(cuid())
  /// URL part: lowercase letters, digits and dashes.
  slug      String   @unique
  title     String
  body      String
  /// Lower numbers are listed first.
  sortOrder Int      @default(100)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions GuideRevision[]

  @@index([published, sortOrder])
}

/// Every saved version of a guide page, newest last, for history and restore.
model GuideRevision {
  id         String   @id @default(cuid())
  pageId     String
  title      String
  body       String
  editorId   String?
  /// Name at the time, kept if the editor's account is deleted.
  editorName String
  createdAt  DateTime @default(now())

  page   GuidePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor User?     @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

/**
 * A player's own report of a game result, waiting for the organizer to approve it. Identified by
 * round/table/players (match rows are rebuilt on every change), so a re-paired round orphans it.
 */
model ResultReport {
  id         String     @id @default(cuid())
  eventId    String
  phase      Phase
  /// 0-based round index within the phase.
  round      Int
  /// 0-based match index within the round.
  match      Int
  /// 1, or 2 for double-sided game 2.
  game       Int
  aEntrantId String
  bEntrantId String
  /// Result from the match's A/B point of view.
  result     GameResult
  reporterId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporter User  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([eventId, phase, round, match, game, reporterId])
  @@index([eventId])
}
